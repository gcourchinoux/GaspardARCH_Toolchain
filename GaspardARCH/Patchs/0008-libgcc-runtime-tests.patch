diff --git a/gcc-4.6.4/libgcc/config/gaspardarc/t-gaspardarc b/gcc-4.6.4/libgcc/config/gaspardarc/t-gaspardarc
new file mode 100644
--- /dev/null
+++ b/gcc-4.6.4/libgcc/config/gaspardarc/t-gaspardarc
@@ -0,0 +1,10 @@
+# Integer-only bootstrap. Floating helpers require a separate soft-float port.
+# Do not build unwinding support until CFI and exception ABI have been validated.
+LIB2ADDEH =
+LIB2ADDEHSTATIC =
+LIB2ADDEHSHARED =
+# No floating/complex helpers: a generic helper could otherwise call itself.
+LIB2FUNCS_EXCLUDE += _powisf2 _powidf2 _powixf2 _powitf2 \
+ _mulsc3 _muldc3 _mulxc3 _multc3 _divsc3 _divdc3 _divxc3 _divtc3 \
+ _trampoline _enable_execute_stack
+LIB2FUNCS_EXCLUDE += $(subst XX,si,$(swfloatfuncs)) $(subst XX,di,$(dwfloatfuncs))
diff --git a/GaspardARCH/runtime/crt0.S b/GaspardARCH/runtime/crt0.S
new file mode 100644
--- /dev/null
+++ b/GaspardARCH/runtime/crt0.S
@@ -0,0 +1,24 @@
+/* Link with board.ld; no operating-system calls. */
+ .text
+ .p2align 2
+ .globl _start
+_start:
+ la sp, __stack_top
+ la t0, __bss_start
+ la t1, __bss_end
+1:
+ beq t0, t1, 2f
+ sb zero, 0(t0)
+ addi t0, t0, 1
+ j 1b
+2:
+ call main
+ la t0, __exit_code
+ sd a0, 0(t0)
+3:
+ j 3b
+ .section .bss,"aw",@nobits
+ .p2align 3
+ .globl __exit_code
+__exit_code:
+ .zero 8
diff --git a/GaspardARCH/runtime/board.ld b/GaspardARCH/runtime/board.ld
new file mode 100644
--- /dev/null
+++ b/GaspardARCH/runtime/board.ld
@@ -0,0 +1,14 @@
+/* Example RAM image, not a physical board specification. */
+OUTPUT_FORMAT("elf64-gaspardarc")
+OUTPUT_ARCH(gaspardarc)
+ENTRY(_start)
+MEMORY { RAM (rwx) : ORIGIN = 0x10000, LENGTH = 1M }
+SECTIONS {
+ .text : { KEEP(*(.text._start)) *(.text .text.*) } > RAM
+ .rodata : { *(.rodata .rodata.*) } > RAM
+ .data : { *(.data .data.*) } > RAM
+ .bss (NOLOAD) : { __bss_start = .; *(.bss .bss.*) *(COMMON) __bss_end = .; } > RAM
+ . = ALIGN(16); __heap_start = .;
+ __stack_top = ORIGIN(RAM) + LENGTH(RAM);
+ ASSERT(__heap_start + 4096 < __stack_top, "not enough RAM for stack")
+}
diff --git a/gcc-4.6.4/gcc/testsuite/gcc.target/gaspardarc/core.c b/gcc-4.6.4/gcc/testsuite/gcc.target/gaspardarc/core.c
new file mode 100644
--- /dev/null
+++ b/gcc-4.6.4/gcc/testsuite/gcc.target/gaspardarc/core.c
@@ -0,0 +1,8 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -ffreestanding" } */
+long add64(long a,long b) { return a+b; }
+int add32(int a,int b) { return a+b; }
+long load64(const long *p) { return *p; }
+int cmp(long a,long b) { return a < b; }
+extern long other(long);
+long nonleaf(long x) { return other(x)+x; }
diff --git a/GaspardARCH/runtime/smoke.c b/GaspardARCH/runtime/smoke.c
new file mode 100644
--- /dev/null
+++ b/GaspardARCH/runtime/smoke.c
@@ -0,0 +1,3 @@
+volatile unsigned long signature;
+__attribute__((noinline)) long add(long a,long b) { return a+b; }
+int main(void) { long v=add(19,23); signature=(v==42)?0x600d:0xbad; return v!=42; }
