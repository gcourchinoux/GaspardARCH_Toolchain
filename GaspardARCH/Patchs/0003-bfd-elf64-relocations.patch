+#define TARGET_LITTLE_SYM       gaspardarc_elf64_le_vec
+#define TARGET_LITTLE_NAME	"elf64-gaspardarc"
+
+#define elf_info_to_howto_rel			NULL
+#define elf_info_to_howto			gaspardarc_info_to_howto_rela
+#define elf_backend_relocate_section		gaspardarc_elf_relocate_section
+#define elf_backend_gc_mark_hook		gaspardarc_elf_gc_mark_hook
+#define elf_backend_check_relocs                gaspardarc_elf_check_relocs
+
+#define elf_backend_can_gc_sections		1
+#define elf_backend_rela_normal			1
+
+#define bfd_elf64_bfd_reloc_type_lookup		gaspardarc_reloc_type_lookup
+#define bfd_elf64_bfd_reloc_name_lookup		gaspardarc_reloc_name_lookup
+
+#define elf_backend_may_use_rel_p 0
+#define elf_backend_may_use_rela_p 1
+#define elf_backend_default_use_rela_p 1
+#include "elf64-target.h"
