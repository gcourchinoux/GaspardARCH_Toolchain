diff --git a/binutils-2.25/include/elf/gaspardarc.h b/binutils-2.25/include/elf/gaspardarc.h
new file mode 100644
--- /dev/null
+++ b/binutils-2.25/include/elf/gaspardarc.h
@@ -0,0 +1,14 @@
+/* Experimental GaspardARC ELF ABI v0. GPL-3.0-or-later. */
+#ifndef ELF_GASPARDARC_H
+#define ELF_GASPARDARC_H
+#include "elf/reloc-macros.h"
+START_RELOC_NUMBERS (elf_gaspardarc_reloc_type)
+  RELOC_NUMBER (R_GASPARDARC_NONE, 0)
+  RELOC_NUMBER (R_GASPARDARC_64, 1)
+  RELOC_NUMBER (R_GASPARDARC_32, 2)
+  RELOC_NUMBER (R_GASPARDARC_BRANCH, 3)
+  RELOC_NUMBER (R_GASPARDARC_JAL, 4)
+  RELOC_NUMBER (R_GASPARDARC_PCREL_HI20, 5)
+  RELOC_NUMBER (R_GASPARDARC_PCREL_LO12_I, 6)
+END_RELOC_NUMBERS (R_GASPARDARC_max)
+#endif
